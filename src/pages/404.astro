---
import PageLayout from '~/layouts/PageLayout.astro';
import NotFound from '~/views/NotFound.astro';
import { t } from '~/i18n';

// GitHub Pages serves a single 404.html for the whole site, so this one page has
// to work for visitors arriving from either language. English is the fallback.
const locale = 'en' as const;
const meta = t(locale).meta.notFound;
---

<PageLayout locale={locale} routeKey="home" title={meta.title} description={meta.description} noIndex>
  <NotFound locale={locale} />
</PageLayout>
