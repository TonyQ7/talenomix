---
import PageLayout from '~/layouts/PageLayout.astro';
import Home from '~/views/Home.astro';
import { t } from '~/i18n';

const locale = 'en' as const;
const meta = t(locale).meta.home;
---

<PageLayout locale={locale} routeKey="home" title={meta.title} description={meta.description}>
  <Home locale={locale} />
</PageLayout>
