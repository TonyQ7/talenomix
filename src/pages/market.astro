---
import PageLayout from '~/layouts/PageLayout.astro';
import Market from '~/views/Market.astro';
import { t } from '~/i18n';

const locale = 'en';
const dict = t(locale);
---
<PageLayout locale={locale} routeKey="market" title={dict.meta.market.title} description={dict.meta.market.description}>
  <Market locale={locale} />
</PageLayout>
