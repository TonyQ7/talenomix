---
import PageLayout from '~/layouts/PageLayout.astro';
import Privacy from '~/views/Privacy.astro';
import { t } from '~/i18n';

const locale = 'sv' as const;
const meta = t(locale).meta.privacy;
---

<PageLayout locale={locale} routeKey="privacy" title={meta.title} description={meta.description}>
  <Privacy locale={locale} />
</PageLayout>
