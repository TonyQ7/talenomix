---
/**
 * Full-bleed hero.
 *
 * `media="video"` renders the film backdrop on the marketing surfaces;
 * `media="still"` renders identical DOM against the gradient alone, at a
 * shorter height, for the functional pages. Sharing one component is what stops
 * those pages reading as half-migrated.
 *
 * Three properties are load-bearing and easy to undo by accident:
 *
 *  - The video is INJECTED by script, never authored. That single decision
 *    gives reduced-motion, no-JS, the /demo/ zero-external-request guarantee,
 *    and pause-button liveness for free, and keeps it off the critical path.
 *  - `.hero-film__wash` sits between the film and the content and is the reason
 *    text on the glass plate has a guaranteed contrast floor. See tokens.css.
 *  - Nothing here uses `opacity: 0` outside a `.js-reveal` selector, or the
 *    no-JS suite fails every `[data-reveal]` on every route.
 */
import { MARKET_FIGURES } from '~/data/market';
import { t } from '~/i18n';
import type { Locale } from '~/lib/routes';
import RevealWords from './RevealWords.astro';

interface Cta {
  readonly label: string;
  readonly href: string;
}

interface Props {
  locale: Locale;
  media?: 'video' | 'still';
  /**
   * Replaces the registry badge. The badge is a marketing metric; on /privacy/
   * or /404 it would be a number in a place where the reader came for something
   * else, so those pages label themselves instead.
   */
  eyebrow?: string;
  headline: string;
  body: string;
  /** Optional: the functional pages carry their calls to action further down. */
  primary?: Cta;
  secondary?: Cta;
}

const {
  locale,
  media = 'still',
  eyebrow,
  headline,
  body,
  primary,
  secondary,
}: Props = Astro.props;
const dict = t(locale);

/**
 * The badge figure is the sum of the two registry frames we have actually
 * resolved — Norway and Finland — looked up by id rather than hardcoded, so it
 * cannot drift from the data. It is deliberately "registry entities", not
 * "firms": NACE 78.100 is a superset that includes staffing, and market.ts says
 * so in its own caveat.
 */
const FRAME_IDS = ['no-frame-2026', 'fi-frame-2026'] as const;
const frameTotal = FRAME_IDS.reduce((sum, id) => {
  const figure = MARKET_FIGURES.find((f) => f.id === id);
  return sum + (figure?.value ?? 0);
}, 0);

/**
 * Held in a data attribute rather than buried in the bundled script so the URL
 * stays visible in the built HTML — scripts/verify-claims.mjs scans for it, and
 * an external media reference the integrity gate cannot see is exactly what that
 * gate exists to prevent.
 */
const FILM_SRC =
  'https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260714_113715_c7e0daa0-8bdd-4486-a2da-040901f8f0ea.mp4';
const frameLabel = new Intl.NumberFormat(locale === 'sv' ? 'sv-SE' : 'en-GB')
  .format(frameTotal)
  .replace(/,/g, ' ');
---

<section class:list={['hero-film', `hero-film--${media}`]}>
  <div class="hero-film__media" aria-hidden="true">
    <div class="hero-film__base"></div>
    {media === 'video' && <div class="hero-film__slot" data-film-slot data-film-src={FILM_SRC}></div>}
    <div class="hero-film__wash"></div>
  </div>

  <div class="shell hero-film__content">
    <div class="glass hero-film__plate" data-reveal>
      {
        eyebrow ? (
          <p class="eyebrow hero-film__eyebrow">{eyebrow}</p>
        ) : (
          <p class="film-badge">
            <span class="live-dot" aria-hidden="true" />
            <span class="film-badge__n num" data-countup>{frameLabel}</span>
            <span class="film-badge__label">{dict.ui.frameBadge}</span>
          </p>
        )
      }

      <RevealWords text={headline} as="h1" class="hero-film__headline" />

      <p class="hero-film__body">{body}</p>

      {
        primary && (
          <div class="btn-row">
            <a class="btn btn--primary" href={primary.href}>
              {primary.label}
              <span class="btn__arrow" aria-hidden="true">→</span>
            </a>
            {secondary && <a class="btn btn--secondary" href={secondary.href}>{secondary.label}</a>}
          </div>
        )
      }
    </div>
  </div>

  {
    media === 'video' && (
      <button class="hero-film__toggle glass" type="button" aria-pressed="false" hidden
        data-film-toggle
        data-pause-label={dict.ui.pauseVideo}
        data-play-label={dict.ui.playVideo}>
        <span class="hero-film__toggle-icon" aria-hidden="true"></span>
        <span class="hero-film__toggle-text">{dict.ui.pauseVideo}</span>
      </button>
    )
  }
</section>

<script>
  // Film injection.
  //
  // The <video> is created here, never authored in the markup. That one
  // decision gives us: no video under reduced motion, none without JavaScript,
  // no external request on pages using media="still" (which is how /demo/ keeps
  // its zero-third-party guarantee), and a pause control that cannot exist
  // without something to control.
  const slot = document.querySelector<HTMLElement>('[data-film-slot]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-film-toggle]');
  const src = slot?.dataset['filmSrc'];

  if (slot && src) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const conn = (navigator as Navigator & {
      connection?: { saveData?: boolean; effectiveType?: string };
    }).connection;
    const thrifty = conn?.saveData === true;
    const slowLink = ['slow-2g', '2g', '3g'].includes(conn?.effectiveType ?? '');
    // Width gate. The source is ~43 MB; until it is re-encoded, handing that to
    // a phone is indefensible whatever the connection reports.
    const roomy = window.matchMedia('(min-width: 64rem)').matches;

    if (!reduced && !thrifty && !slowLink && roomy) {
      const start = (): void => {
        const video = document.createElement('video');
        video.src = src;
        video.muted = true;
        // Attribute as well as property: axe's no-autoplay-audio matcher reads
        // the attribute, and iOS requires it present for inline autoplay.
        video.setAttribute('muted', '');
        video.loop = true;
        video.playsInline = true;
        video.autoplay = true;
        video.tabIndex = -1;
        // Decorative. A silent loop is not synchronized media, so it leaves the
        // accessibility tree rather than carrying a sham captions track.
        video.setAttribute('aria-hidden', 'true');
        video.setAttribute('disablepictureinpicture', '');
        slot.appendChild(video);

        // Only an autoplay *refusal* should retire the control.
        //
        // A pending play() rejects with AbortError the moment anything calls
        // pause() — including the pause button itself. Retiring the control on
        // that meant the first press made the button vanish and dropped keyboard
        // focus to <body>, so the film could be paused exactly once and never
        // resumed. Covered by tests/film.spec.ts.
        const retireOnRefusal = (error: unknown): void => {
          if ((error as DOMException | undefined)?.name === 'AbortError') return;
          // The gradient is already behind it, so there is nothing to restore.
          toggle?.setAttribute('hidden', '');
        };

        void video.play().catch(retireOnRefusal);

        if (toggle) {
          toggle.removeAttribute('hidden');
          const label = toggle.querySelector<HTMLElement>('.hero-film__toggle-text');
          toggle.addEventListener('click', () => {
            const wasPaused = video.paused;
            if (wasPaused) void video.play().catch(retireOnRefusal);
            else video.pause();
            toggle.setAttribute('aria-pressed', String(!wasPaused));
            const next = wasPaused
              ? (toggle.dataset['pauseLabel'] ?? '')
              : (toggle.dataset['playLabel'] ?? '');
            if (label) label.textContent = next;
          });
        }
      };

      // After load, so the film never competes with first paint.
      if (document.readyState === 'complete') start();
      else window.addEventListener('load', start, { once: true });
    }
  }
</script>
