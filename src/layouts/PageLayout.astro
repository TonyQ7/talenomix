---
import '~/styles/global.css';
import { HREFLANG, HTML_LANG, LOCALES, route, asset, type Locale, type RouteKey } from '~/lib/routes';
import { t } from '~/i18n';
import SiteHeader from '~/components/SiteHeader.astro';
import SiteFooter from '~/components/SiteFooter.astro';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
  title: string;
  description: string;
  /** 404 has no canonical counterpart worth advertising to crawlers. */
  noIndex?: boolean;
}

const { locale, routeKey, title, description, noIndex = false } = Astro.props;
const dict = t(locale);

const canonical = new URL(route(routeKey, locale), Astro.site);
const alternates = LOCALES.map((l) => ({
  hreflang: HREFLANG[l],
  href: new URL(route(routeKey, l), Astro.site).toString(),
}));
---

<!doctype html>
<html lang={HTML_LANG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.toString()} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(route(routeKey, 'en'), Astro.site).toString()} />
    {noIndex && <meta name="robots" content="noindex, nofollow, noarchive" />}

    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#f2efe7" />
    <meta name="color-scheme" content="light" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={dict.meta.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:locale" content={locale === 'sv' ? 'sv_SE' : 'en_GB'} />
    <meta name="twitter:card" content="summary" />

    {/*
      Adds a marker class before first paint so the reveal styles only ever apply
      when JavaScript is running. Without this, a no-JS visitor would see nothing.
    */}
    <script is:inline>
      document.documentElement.classList.add('js-reveal');
    </script>
  </head>

  <body>
    {/* Scroll-driven CSS timeline. No listener, no script, and it simply does
        not render where `animation-timeline` is unsupported. */}
    <div class="scroll-rail" aria-hidden="true"></div>
    <a class="skip-link" href="#main">{dict.ui.skipToContent}</a>
    <SiteHeader locale={locale} routeKey={routeKey} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter locale={locale} routeKey={routeKey} />

    <script>
      // Restrained reveal motion. Anything not observed stays visible, and the
      // reduced-motion media query neutralises every transition in CSS, so the
      // worst case here is that elements are marked revealed immediately.
      //
      // Three families share one observer:
      //   [data-reveal]       — section fade/rise
      //   [data-draw]         — charts and the contour map draw themselves in
      //   [data-reveal-words] — headline words ride up behind a mask
      const targets = document.querySelectorAll<HTMLElement>(
        '[data-reveal], [data-draw], [data-reveal-words]',
      );
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!reduced && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-revealed');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        for (const el of targets) observer.observe(el);
      } else {
        for (const el of targets) el.classList.add('is-revealed');
      }

      // Count-up. The final value is already in the HTML — this only animates
      // from zero to what is rendered, so no-JS and reduced-motion readers see
      // the real number and never a placeholder.
      if (!reduced && 'IntersectionObserver' in window) {
        const counters = document.querySelectorAll<HTMLElement>('[data-countup]');
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const el = entry.target as HTMLElement;
              io.unobserve(el);

              const final = el.textContent ?? '';
              const match = final.match(/-?\d[\d\s.,]*/);
              if (!match) continue;
              const target = Number(match[0].replace(/[\s,]/g, ''));
              if (!Number.isFinite(target)) continue;

              const start = performance.now();
              const duration = 900;
              const tick = (now: number): void => {
                const p = Math.min(1, (now - start) / duration);
                // easeOutCubic — fast then settling, so the number reads as
                // arriving at a value rather than ticking mechanically.
                const eased = 1 - Math.pow(1 - p, 3);
                el.textContent = final.replace(
                  match[0],
                  String(Math.round(target * eased)),
                );
                if (p < 1) requestAnimationFrame(tick);
                else el.textContent = final;
              };
              requestAnimationFrame(tick);
            }
          },
          { threshold: 0.5 },
        );
        for (const el of counters) io.observe(el);
      }
    </script>
  </body>
</html>
