---
/**
 * Named account brief.
 *
 * Delivered by link, never linked from the site, noindex + excluded from the
 * sitemap. Every statement about the firm resolves to a claim in
 * src/data/claims.ts, so scripts/verify-claims.mjs holds this page to exactly
 * the same standard as the public evidence ledger — which is the point: the
 * sales document has to be as checkable as the product it is selling.
 */
import type { AccountBrief } from '~/data/brief';
import { CLAIMS } from '~/data/claims';
import { route, type Locale } from '~/lib/routes';
import { t } from '~/i18n';

interface Props {
  locale: Locale;
  brief: AccountBrief;
}

const { locale, brief }: Props = Astro.props;
const dict = t(locale);
const claimById = new Map(CLAIMS.map((claim) => [claim.id, claim]));
---

<article class="brief">
  <!-- ------------------------------------------------------------ masthead -->
  <header class="brief__masthead">
    <div class="shell">
      <div class="brief__stamp">
        <p class="console__title">
          <span class="live-dot" aria-hidden="true"></span>
          {brief.eyebrow}
        </p>
        <p class="console__status">{brief.status}</p>
      </div>

      <h1 class="brief__headline">{brief.headline}</h1>
      <p class="brief__standfirst">{brief.standfirst}</p>

      <dl class="brief__meta">
        <div><dt>Firm</dt><dd>{brief.firm}</dd></div>
        <div><dt>Addressed to</dt><dd>{brief.addressedTo.replace('Prepared for: ', '')}</dd></div>
        <div><dt>Prepared</dt><dd>{brief.preparedOn}</dd></div>
        <div><dt>Sources</dt><dd>{brief.quotes.length + brief.contrasts.length} cited</dd></div>
      </dl>
    </div>
  </header>

  <!-- ------------------------------------------------------- what you say -->
  <section class="section" id="published">
    <div class="shell">
      <div class="brief__head" data-reveal>
        <p class="eyebrow">{brief.quotesTitle}</p>
        <p class="lede">{brief.quotesLede}</p>
      </div>

      <ol class="quote-grid">
        {
          brief.quotes.map((q, i) => {
            const claim = claimById.get(q.sourceId);
            return (
              <li class="quote-card card--marked lift" data-reveal style={`--reveal-delay:${i * 80}ms`}>
                <span class="code quote-card__n">{String(i + 1).padStart(2, '0')}</span>
                <blockquote class="quote-card__quote">“{q.quote}”</blockquote>
                <p class="quote-card__reading">{q.reading}</p>
                {claim && (
                  <p class="quote-card__src">
                    <a class="link" href={claim.source.url} rel="noopener nofollow" target="_blank">
                      {claim.source.publisher}
                      <span class="visually-hidden"> ({dict.ui.opensNewTab})</span>
                    </a>
                    <span class="code"> · {dict.ui.retrieved} {claim.source.retrievedOn}</span>
                  </p>
                )}
              </li>
            );
          })
        }
      </ol>
    </div>
  </section>

  <!-- ---------------------------------------------------------- the tension -->
  <section class="section panel--ink" id="tension">
    <div class="shell">
      <div class="brief__head" data-reveal>
        <p class="eyebrow">{brief.tensionTitle}</p>
        <p class="lede">{brief.tensionLede}</p>
      </div>

      <ol class="steps">
        {
          brief.tensions.map((tension) => (
            <li class="step" data-reveal>
              <span class="step__n" aria-hidden="true">{tension.n}</span>
              <div><h2 class="brief__h3">{tension.title}</h2></div>
              <div><p class="step__body">{tension.body}</p></div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ------------------------------------------------------- the contrast -->
  <section class="section panel--sunk" id="contrast">
    <div class="shell">
      <div class="brief__head" data-reveal>
        <p class="eyebrow">{brief.contrastTitle}</p>
        <p class="lede">{brief.contrastLede}</p>
      </div>

      <div class="versus" data-reveal>
        <div class="versus__col versus__col--them">
          <p class="code">What the category sells</p>
          {
            brief.contrasts.map((c) => {
              const claim = claimById.get(c.claimId);
              return (
                <div class="versus__item">
                  <p class="versus__vendor">{c.vendor}</p>
                  {claim?.source.passage && (
                    <blockquote class="versus__quote">“{claim.source.passage}”</blockquote>
                  )}
                  <p class="versus__conflict">{c.conflict}</p>
                  {claim && (
                    <p class="code">
                      <a class="link" href={claim.source.url} rel="noopener nofollow" target="_blank">
                        {claim.source.publisher}
                        <span class="visually-hidden"> ({dict.ui.opensNewTab})</span>
                      </a>
                      {' · '}{dict.ui.vendorClaimNote}
                    </p>
                  )}
                </div>
              );
            })
          }
        </div>

        <div class="versus__col versus__col--you">
          <p class="code">What you published</p>
          <div class="versus__item versus__item--anchor">
            <blockquote class="versus__quote versus__quote--anchor">
              “{brief.quotes[0]?.quote}”
            </blockquote>
            <p class="versus__conflict">{brief.contrastClose}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- -------------------------------------------------------------- the fit -->
  <section class="section" id="fit">
    <div class="shell">
      <div class="brief__head" data-reveal>
        <p class="eyebrow">{brief.fitTitle}</p>
        <p class="lede">{brief.fitLede}</p>
      </div>

      <ul class="card-grid">
        {
          brief.fitPoints.map((point, i) => (
            <li class="card card--marked lift" data-reveal style={`--reveal-delay:${i * 70}ms`}>
              <div class="card__head">
                <h2 class="brief__h3">{point.label}</h2>
                <span class="code">{String(i + 1).padStart(2, '0')}</span>
              </div>
              <p class="card__body">{point.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ------------------------------------------------------- the engagement -->
  <section class="section panel--ink" id="run">
    <div class="shell">
      <div class="brief__head" data-reveal>
        <p class="eyebrow">{brief.runTitle}</p>
        <p class="lede">{brief.runLede}</p>
      </div>

      <ol class="steps">
        {
          brief.runSteps.map((step) => (
            <li class="step" data-reveal>
              <span class="step__n" aria-hidden="true">{step.n}</span>
              <div><h2 class="brief__h3">{step.title}</h2></div>
              <div>
                <p class="step__body">{step.body}</p>
                <p class="step__stamp">{step.stamp}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ------------------------------------------------------------ unknowns -->
  <section class="section" id="unknowns">
    <div class="shell shell--narrow">
      <div class="brief__head" data-reveal>
        <p class="eyebrow">{brief.unknownTitle}</p>
        <p class="lede">{brief.unknownLede}</p>
      </div>

      <ul class="checklist checklist--negative" data-reveal>
        {
          brief.unknowns.map((item) => (
            <li>
              <span class="checklist__mark" aria-hidden="true">?</span>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ----------------------------------------------------------------- ask -->
  <section class="section panel--ink" id="ask">
    <div class="shell">
      <div class="brief__ask" data-reveal>
        <div>
          <p class="eyebrow">{brief.askTitle}</p>
          <h2 class="brief__asktitle">{brief.askBody}</h2>
          <div class="btn-row">
            <a class="btn btn--primary" href={route('demo', locale)}>
              See the product in action<span class="btn__arrow" aria-hidden="true">→</span>
            </a>
            <a class="btn btn--secondary" href={route('method', locale)}>How we source everything</a>
          </div>
        </div>

        <ul class="checklist">
          {
            brief.askPoints.map((point) => (
              <li>
                <span class="checklist__mark" aria-hidden="true">✓</span>
                <span>{point}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <p class="provisional brief__note">{brief.askNote}</p>
    </div>
  </section>
</article>

<style>
  /* ---- Masthead ---------------------------------------------------------- */
  .brief__masthead {
    background: var(--ink);
    color: var(--on-ink);
    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(2.5rem, 6vw, 4.5rem);
  }

  .brief__stamp {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem 1.5rem;
    padding-bottom: clamp(1.5rem, 4vw, 2.5rem);
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
    border-bottom: 1px solid var(--rule-on-ink);
  }

  .brief__headline {
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 1.1rem + 4.2vw, 4.25rem);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    max-width: 18ch;
  }

  .brief__standfirst {
    margin-top: 1.25rem;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--on-ink-muted);
    max-width: var(--measure);
  }

  .brief__meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr));
    gap: 1px;
    margin-top: clamp(1.75rem, 4vw, 2.75rem);
    background: var(--rule-on-ink);
    border: 1px solid var(--rule-on-ink);
  }

  .brief__meta > div {
    background: var(--ink);
    padding: 0.85rem 1rem;
    min-inline-size: 0;
  }

  .brief__meta dt {
    font-size: var(--step--2);
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--on-ink-faint);
  }

  .brief__meta dd {
    margin: 0.3rem 0 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--on-ink);
  }

  /* ---- Shared ------------------------------------------------------------ */
  .brief__head {
    display: grid;
    gap: 0.9rem;
    padding-bottom: 1.5rem;
    margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
    border-bottom: 1px solid var(--rule);
  }

  .panel--ink .brief__head {
    border-bottom-color: var(--rule-on-ink);
  }

  /* Real h2s so the document outlines correctly; sized like the h3s they replace. */
  .brief__h3 {
    font-family: var(--font-sans);
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    line-height: 1.25;
  }

  /* ---- Quote cards ------------------------------------------------------- */
  .quote-grid {
    display: grid;
    gap: clamp(0.9rem, 2vw, 1.35rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    list-style: none;
  }

  .quote-card {
    position: relative;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    padding: clamp(1.15rem, 2.4vw, 1.75rem);
    display: grid;
    gap: 0.8rem;
    align-content: start;
    min-inline-size: 0;
  }

  .quote-card__quote {
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.35;
    letter-spacing: -0.01em;
    border-inline-start: 2px solid var(--cobalt);
    padding-inline-start: 0.9rem;
  }

  .quote-card__reading {
    font-size: var(--step--1);
    color: var(--ink-muted);
    line-height: 1.55;
  }

  .quote-card__src {
    font-size: var(--step--2);
    padding-top: 0.7rem;
    border-top: 1px solid var(--rule);
  }

  /* ---- Versus ------------------------------------------------------------ */
  .versus {
    display: grid;
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
  }

  @media (min-width: 58rem) {
    .versus {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    }
  }

  .versus__col {
    background: var(--paper);
    padding: clamp(1.15rem, 2.5vw, 1.75rem);
    display: grid;
    gap: 1.25rem;
    align-content: start;
    min-inline-size: 0;
  }

  .versus__col--you {
    background: var(--ink);
    color: var(--on-ink);
  }

  /* The left column carries two vendor quotes and is always taller. Centring
     the single anchor quote keeps it opposite them rather than stranded at the
     top of a mostly empty panel. */
  @media (min-width: 58rem) {
    .versus__col--you {
      align-content: center;
    }
  }

  .versus__col--you .code {
    color: var(--mint-light);
  }

  .versus__item {
    display: grid;
    gap: 0.5rem;
  }

  .versus__item + .versus__item {
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
  }

  .versus__vendor {
    font-weight: 700;
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .versus__quote {
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.3;
    color: var(--state-unresolved);
  }

  .versus__quote--anchor {
    color: var(--mint-light);
    font-size: var(--step-2);
    line-height: 1.25;
  }

  .versus__conflict {
    font-size: var(--step--1);
    color: var(--ink-muted);
    line-height: 1.55;
  }

  .versus__col--you .versus__conflict {
    color: var(--on-ink-muted);
  }

  /* ---- Ask --------------------------------------------------------------- */
  .brief__ask {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
    align-items: start;
  }

  @media (min-width: 58rem) {
    .brief__ask {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    }
  }

  .brief__asktitle {
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1.15;
    letter-spacing: var(--tracking-display);
    max-width: 20ch;
    margin: 0.75rem 0 1.75rem;
  }

  .brief__note {
    margin-top: clamp(2rem, 4vw, 3rem);
    max-width: 68ch;
  }
</style>
