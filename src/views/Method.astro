---
import { route, type Locale } from '~/lib/routes';
import { t } from '~/i18n';
import { CLAIMS } from '~/data/claims';
import ClaimLedger from '~/components/ClaimLedger.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const m = dict.method;
---

<section class="section section--tight">
  <div class="shell">
    <div class="page-head">
      <p class="eyebrow">{m.eyebrow}</p>
      <h1>{m.title}</h1>
      <p class="lede">{m.lede}</p>
    </div>
  </div>
</section>

<section class="section">
  <div class="shell">
    <div class="method-layout">
      <nav class="method-toc" aria-label={m.eyebrow}>
        <ol>
          {
            m.sections.map((s, i) => (
              <li>
                <a href={`#${s.id}`}>
                  <span class="code">{String(i + 1).padStart(2, '0')}</span>
                  {s.title}
                </a>
              </li>
            ))
          }
          <li>
            <a href="#ledger">
              <span class="code">{String(m.sections.length + 1).padStart(2, '0')}</span>
              {m.ledgerTitle}
            </a>
          </li>
          <li>
            <a href="#unknowns">
              <span class="code">{String(m.sections.length + 2).padStart(2, '0')}</span>
              {m.unknownTitle}
            </a>
          </li>
        </ol>
      </nav>

      <div class="method-body">
        {
          m.sections.map((s, i) => (
            <article class="method-section" id={s.id} data-reveal>
              <div class="method-section__head">
                <span class="code">{String(i + 1).padStart(2, '0')}</span>
                <h2>{s.title}</h2>
              </div>
              {s.body.map((para) => <p class="method-p">{para}</p>)}
              {s.list && (
                <ul class="checklist" style="margin-top: 1.25rem">
                  {s.list.map((item) => (
                    <li>
                      <span class="checklist__mark" aria-hidden="true">·</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              )}
              {s.id === 'grading' && (
                <dl class="grades">
                  {m.grades.map((g) => (
                    <div class="grade">
                      <dt>{g.label}</dt>
                      <dd>{g.body}</dd>
                    </div>
                  ))}
                </dl>
              )}
            </article>
          ))
        }

        <article class="method-section" id="ledger" data-reveal>
          <div class="method-section__head">
            <span class="code">{String(m.sections.length + 1).padStart(2, '0')}</span>
            <h2>{m.ledgerTitle}</h2>
          </div>
          <p class="method-p">{m.ledgerLede}</p>
          <div style="margin-top: 1.75rem">
            <ClaimLedger locale={locale} claims={CLAIMS} />
          </div>
        </article>

        <article class="method-section" id="unknowns" data-reveal>
          <div class="method-section__head">
            <span class="code">{String(m.sections.length + 2).padStart(2, '0')}</span>
            <h2>{m.unknownTitle}</h2>
          </div>
          <ul class="checklist checklist--negative" style="margin-top: 0.5rem">
            {
              m.unknowns.map((item) => (
                <li>
                  <span class="checklist__mark" aria-hidden="true">?</span>
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </article>

        <p class="field-note" style="margin-top: 3rem">
          <a class="link" href={route('privacy', locale)}>{dict.nav.privacy}</a>
          {' · '}
          <a class="link" href={route('demo', locale)}>{dict.nav.demo}</a>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .page-head {
    display: grid;
    gap: 1.25rem;
  }

  .page-head h1 {
    max-width: 15ch;
  }

  .page-head .lede {
    max-width: var(--measure);
  }

  .method-layout {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  @media (min-width: 62rem) {
    .method-layout {
      grid-template-columns: 16rem minmax(0, 1fr);
    }

    .method-toc {
      position: sticky;
      top: 6rem;
    }
  }

  .method-toc ol {
    display: grid;
    gap: 0.65rem;
    border-inline-start: 1px solid var(--rule);
    padding-inline-start: 1.1rem;
  }

  .method-toc a {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 0.35rem;
    font-size: var(--step--1);
    color: var(--ink-muted);
    text-decoration: none;
    line-height: 1.4;
  }

  .method-toc a:hover {
    color: var(--cobalt);
  }

  .method-body {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  .method-section__head {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 0.5rem;
    align-items: baseline;
    padding-bottom: 1rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--rule);
  }

  .method-section__head h2 {
    font-family: var(--font-sans);
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    line-height: 1.2;
  }

  .method-p {
    max-width: var(--measure);
    color: var(--ink-muted);
  }

  .method-p + .method-p {
    margin-top: 1em;
  }

  .grades {
    display: grid;
    gap: 0;
    margin-top: 1.75rem;
    border-top: 1px solid var(--rule);
  }

  .grade {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 0.75rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--rule);
    align-items: baseline;
  }

  .grade dt {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1;
    color: var(--cobalt);
  }

  .grade dd {
    font-size: var(--step--1);
    color: var(--ink-muted);
    line-height: 1.55;
  }
</style>
