---
import { anchor, route, type Locale } from '~/lib/routes';
import { t } from '~/i18n';
import { homeClaims } from '~/data/claims';
import MandateUniverse from '~/components/MandateUniverse.astro';
import SectionHead from '~/components/SectionHead.astro';
import CoverageLegend from '~/components/CoverageLegend.astro';
import ClaimLedger from '~/components/ClaimLedger.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const h = dict.home;
const sheetLabel = dict.ui.sheet;
const claims = homeClaims();
---

<!-- ==================================================================== HERO -->
<section class="hero">
  <div class="shell">
    <div class="hero__head">
      <p class="eyebrow" data-reveal>{h.hero.eyebrow}</p>
      <h1 data-reveal style="--reveal-delay: 60ms">{h.hero.headline}</h1>
    </div>

    <div class="hero__grid">
      <div class="hero__lead" data-reveal style="--reveal-delay: 120ms">
        <p class="lede">{h.hero.body}</p>
        <div class="btn-row">
          <a class="btn btn--primary" href={anchor(locale, 'design-partners')}>
            {h.hero.primaryCta}
            <span class="btn__arrow" aria-hidden="true">→</span>
          </a>
          <a class="btn btn--secondary" href={route('demo', locale)}>{h.hero.secondaryCta}</a>
        </div>
      </div>

      <div class="hero__aside" data-reveal style="--reveal-delay: 180ms">
        <p class="code">{h.hero.mapLegendTitle}</p>
        <CoverageLegend locale={locale} />
      </div>
    </div>
  </div>

  <div class="shell">
    <figure class="map-frame" data-reveal style="--reveal-delay: 220ms">
      <MandateUniverse locale={locale} variant="hero" id="mu-hero" />
      <figcaption class="map-frame__caption">
        <p>{h.hero.mapCaption}</p>
        <p class="code">{h.hero.mapTitle} · SYNTH-01</p>
      </figcaption>
    </figure>
  </div>
</section>

<!-- ========================================================== THE BOTTLENECK -->
<section class="section" id="bottleneck">
  <div class="shell">
    <SectionHead
      eyebrow={h.bottleneck.eyebrow}
      title={h.bottleneck.title}
      lede={h.bottleneck.lede}
      sheet="01 / 07"
      sheetLabel={sheetLabel}
    />

    <ul class="card-grid">
      {
        h.bottleneck.items.map((item, i) => (
          <li class="card card--marked" data-reveal style={`--reveal-delay: ${i * 70}ms`}>
            <div class="card__head">
              <h3>{item.label}</h3>
              <span class="code">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <p class="card__body">{item.body}</p>
          </li>
        ))
      }
    </ul>

    <p class="field-note" style="margin-top: 2.5rem" data-reveal>{h.bottleneck.note}</p>
  </div>
</section>

<!-- ============================================== PRODUCT / WORKFLOW (steps) -->
<section class="section panel--ink" id="product">
  <div class="shell">
    <SectionHead
      eyebrow={h.workflow.eyebrow}
      title={h.workflow.title}
      lede={h.workflow.lede}
      sheet="02 / 07"
      sheetLabel={sheetLabel}
    />

    <p class="divider-label" style="margin-bottom: 0.5rem">{h.workflow.inputLabel}</p>

    <ol class="steps" id="workflow">
      {
        h.workflow.steps.map((step) => (
          <li class="step" data-reveal>
            <span class="step__n" aria-hidden="true">{step.n}</span>
            <div>
              <h3>{step.title}</h3>
            </div>
            <div>
              <p class="step__body">{step.body}</p>
              <p class="step__stamp">
                <span aria-hidden="true">✓</span>
                {step.stamp}
              </p>
            </div>
          </li>
        ))
      }
    </ol>

    <p class="divider-label" style="margin-top: 1.25rem">{h.workflow.outputLabel}</p>
    <p class="field-note" style="margin-top: 2rem" data-reveal>{h.workflow.note}</p>
  </div>
</section>

<!-- ================================================================ THE DEMO -->
<section class="section" id="demo">
  <div class="shell">
    <SectionHead
      eyebrow={h.demo.eyebrow}
      title={h.demo.title}
      lede={h.demo.lede}
      sheet="03 / 07"
      sheetLabel={sheetLabel}
    />

    <div class="demo-teaser" data-reveal>
      <ul class="checklist">
        {
          h.demo.points.map((point) => (
            <li>
              <span class="checklist__mark" aria-hidden="true">✓</span>
              <span>{point}</span>
            </li>
          ))
        }
      </ul>
      <div>
        <a class="btn btn--primary" href={route('demo', locale)}>
          {h.demo.cta}
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        <p class="note-inline" style="margin-top: 1rem; max-width: 40ch">{h.demo.note}</p>
      </div>
    </div>
  </div>
</section>

<!-- ====================================================== ABOVE YOUR SYSTEMS -->
<section class="section panel--sunk" id="stack">
  <div class="shell">
    <SectionHead
      eyebrow={h.stack.eyebrow}
      title={h.stack.title}
      lede={h.stack.lede}
      sheet="04 / 07"
      sheetLabel={sheetLabel}
    />

    <div class="io-grid io-grid--three" data-reveal>
      <div class="io-cell">
        <p class="code">{h.stack.inputTitle}</p>
        <ul class="tag-row">
          {h.stack.inputItems.map((item) => <li class="tag">{item}</li>)}
        </ul>
      </div>
      <div class="io-cell io-cell--accent">
        <p class="code">{h.stack.coreTitle}</p>
        <ul class="tag-row">
          {h.stack.coreItems.map((item) => <li class="tag">{item}</li>)}
        </ul>
      </div>
      <div class="io-cell">
        <p class="code">{h.stack.outputTitle}</p>
        <ul class="tag-row">
          {h.stack.outputItems.map((item) => <li class="tag">{item}</li>)}
        </ul>
      </div>
    </div>

    <blockquote class="pullquote" data-reveal style="margin-top: clamp(2.5rem, 5vw, 4rem); max-width: 26ch">
      {h.stack.pullquote}
    </blockquote>
    <p class="field-note" style="margin-top: 1.75rem" data-reveal>{h.stack.note}</p>
  </div>
</section>

<!-- ====================================================== WHAT REMAINS HUMAN -->
<section class="section" id="human">
  <div class="shell">
    <SectionHead
      eyebrow={h.human.eyebrow}
      title={h.human.title}
      lede={h.human.lede}
      sheet="05 / 07"
      sheetLabel={sheetLabel}
    />

    <div class="split" data-reveal>
      <div class="card card--marked">
        <h3>{h.human.humanTitle}</h3>
        <ul class="checklist" style="margin-top: 0.75rem">
          {
            h.human.humanItems.map((item) => (
              <li>
                <span class="checklist__mark" aria-hidden="true">✓</span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="card card--marked">
        <h3>{h.human.neverTitle}</h3>
        <ul class="checklist checklist--negative" style="margin-top: 0.75rem">
          {
            h.human.neverItems.map((item) => (
              <li>
                <span class="checklist__mark" aria-hidden="true">×</span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <p class="field-note" style="margin-top: 2.5rem" data-reveal>
      {h.human.note}{' '}
      <a class="link" href={h.human.noteLinkHref} rel="noopener nofollow" target="_blank">
        {h.human.noteLinkText}
        <span class="visually-hidden"> ({dict.ui.opensNewTab})</span>
      </a>
    </p>
  </div>
</section>

<!-- ========================================================= DESIGN PARTNERS -->
<section class="section panel--ink" id="design-partners">
  <div class="shell">
    <SectionHead
      eyebrow={h.partners.eyebrow}
      title={h.partners.title}
      lede={h.partners.lede}
      sheet="06 / 07"
      sheetLabel={sheetLabel}
    />

    <div class="partner-grid">
      <div class="card" data-reveal>
        <h3>{h.partners.termsTitle}</h3>
        <ul class="checklist" style="margin-top: 0.75rem">
          {
            h.partners.terms.map((item) => (
              <li>
                <span class="checklist__mark" aria-hidden="true">✓</span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="card" data-reveal style="--reveal-delay: 70ms">
        <h3>{h.partners.deliverablesTitle}</h3>
        <ul class="checklist" style="margin-top: 0.75rem">
          {
            h.partners.deliverables.map((item) => (
              <li>
                <span class="checklist__mark" aria-hidden="true">✓</span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="card" data-reveal style="--reveal-delay: 140ms">
        <h3>{h.partners.fitTitle}</h3>
        <ul class="checklist" style="margin-top: 0.75rem">
          {
            h.partners.fit.map((item) => (
              <li>
                <span class="checklist__mark" aria-hidden="true">□</span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="partner-close" data-reveal>
      <div>
        <p class="eyebrow">{h.partners.metricTitle}</p>
        <p class="pullquote" style="margin-top: 1rem; max-width: 30ch">{h.partners.metricBody}</p>
      </div>
      <div class="stack" style="--stack-gap: 1.1rem">
        <h3>{h.partners.applyTitle}</h3>
        <p class="card__body">{h.partners.applyBody}</p>
        <p class="step__stamp" style="max-width: 46ch; line-height: 1.5; white-space: normal">
          {h.partners.applyStatus}
        </p>
        <p class="note-inline">{h.partners.priceNote}</p>
      </div>
    </div>
  </div>
</section>

<!-- ========================================================== EVIDENCE LEDGER -->
<section class="section" id="evidence">
  <div class="shell">
    <SectionHead
      eyebrow={h.evidence.eyebrow}
      title={h.evidence.title}
      lede={h.evidence.lede}
      sheet="07 / 07"
      sheetLabel={sheetLabel}
    />

    <div data-reveal>
      <ClaimLedger locale={locale} claims={claims} />
    </div>

    <div class="evidence-close" data-reveal>
      <div class="card card--marked">
        <h3>{h.evidence.notClaimedTitle}</h3>
        <ul class="checklist checklist--negative" style="margin-top: 0.75rem">
          {
            h.evidence.notClaimed.map((item) => (
              <li>
                <span class="checklist__mark" aria-hidden="true">×</span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <a class="btn btn--secondary" href={route('method', locale)}>
          {h.evidence.cta}
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- ===================================================================== FAQ -->
<section class="section panel--sunk" id="faq">
  <div class="shell shell--narrow">
    <SectionHead eyebrow={h.faq.eyebrow} title={h.faq.title} />

    <div class="faq" data-reveal>
      {
        h.faq.items.map((item) => (
          <details class="faq__item" name="talenomix-faq">
            <summary class="faq__q">
              {item.q}
              <span class="faq__sign" aria-hidden="true" />
            </summary>
            <div class="faq__a">
              {item.a.map((para) => <p>{para}</p>)}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<!-- =============================================================== FINAL CTA -->
<section class="section panel--ink" id="apply">
  <div class="shell">
    <div class="final" data-reveal>
      <p class="eyebrow">{h.finalCta.eyebrow}</p>
      <h2 style="max-width: 18ch">{h.finalCta.title}</h2>
      <p class="lede" style="max-width: 52ch">{h.finalCta.body}</p>
      <div class="btn-row">
        <a class="btn btn--primary" href={anchor(locale, 'design-partners')}>
          {h.finalCta.primaryCta}
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn btn--secondary" href={route('demo', locale)}>{h.finalCta.secondaryCta}</a>
      </div>
    </div>
  </div>
</section>

<style>
  /* ---- Hero ---- */
  .hero {
    padding-block: clamp(3rem, 7vw, 6rem) var(--space-section);
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  .hero__head {
    display: grid;
    gap: 1.5rem;
    max-width: 20ch;
  }

  .hero__head h1 {
    max-width: 15ch;
  }

  .hero__grid {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3.5rem);
    margin-top: clamp(2rem, 4vw, 3rem);
    align-items: start;
  }

  @media (min-width: 62rem) {
    .hero__head {
      max-width: none;
    }
    .hero__grid {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    }
  }

  .hero__lead {
    display: grid;
    gap: 1.75rem;
    justify-items: start;
  }

  .hero__aside {
    display: grid;
    gap: 0.9rem;
    padding-top: 0.35rem;
  }

  @media (min-width: 62rem) {
    .hero__aside {
      border-inline-start: 1px solid var(--rule);
      padding-inline-start: clamp(1.5rem, 3vw, 2.5rem);
    }
  }

  /* ---- Demo teaser ---- */
  .demo-teaser {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
    align-items: start;
  }

  @media (min-width: 52rem) {
    .demo-teaser {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    }
  }

  /* ---- Two-card split ---- */
  .split {
    display: grid;
    gap: clamp(1rem, 2.5vw, 1.75rem);
  }

  @media (min-width: 52rem) {
    .split {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* ---- Design partners ---- */
  .partner-grid {
    display: grid;
    gap: clamp(1rem, 2.5vw, 1.5rem);
  }

  @media (min-width: 58rem) {
    .partner-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .partner-close {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--rule-on-ink);
  }

  @media (min-width: 58rem) {
    .partner-close {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  /* ---- Evidence ---- */
  .evidence-close {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    align-items: start;
  }

  @media (min-width: 58rem) {
    .evidence-close {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    }
  }

  /* ---- Final CTA ---- */
  .final {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }
</style>
