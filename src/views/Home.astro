---
import { anchor, route, type Locale } from '~/lib/routes';
import { t } from '~/i18n';
import { homeClaims } from '~/data/claims';
import MandateUniverse from '~/components/MandateUniverse.astro';
import SectionHead from '~/components/SectionHead.astro';
import CoverageLegend from '~/components/CoverageLegend.astro';
import ClaimLedger from '~/components/ClaimLedger.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const h = dict.home;
const sheetLabel = dict.ui.sheet;
const claims = homeClaims().slice(0, 3);
const [step1, step2, step3, step4, step5, step6, step7] = h.workflow.steps;
if (!step1 || !step2 || !step3 || !step4 || !step5 || !step6 || !step7) {
  throw new Error('Homepage workflow requires all seven demo steps.');
}
const workflowPhases = [
  {
    n: '01',
    title: step1.title,
    body: `${step1.body} ${step2.body}`,
    stamp: step2.stamp,
  },
  {
    n: '02',
    title: step3.title,
    body: `${step3.body} ${step4.body} ${step5.body}`,
    stamp: step5.stamp,
  },
  {
    n: '03',
    title: step6.title,
    body: `${step6.body} ${step7.body}`,
    stamp: step7.stamp,
  },
] as const;
---

<!-- 01 — one clear promise, outcomes, and the visual product metaphor -->
<section class="hero">
  <div class="shell">
    <div class="hero__head">
      <p class="eyebrow" data-reveal>{h.hero.eyebrow}</p>
      <h1 data-reveal style="--reveal-delay: 60ms">{h.hero.headline}</h1>
    </div>

    <div class="hero__grid">
      <div class="hero__lead" data-reveal style="--reveal-delay: 120ms">
        <p class="lede">{h.hero.body}</p>
        <div class="btn-row">
          <a class="btn btn--primary" href={route('demo', locale)}>
            {h.hero.primaryCta}<span class="btn__arrow" aria-hidden="true">→</span>
          </a>
          <a class="btn btn--secondary" href={route('market', locale)}>{dict.nav.market}</a>
        </div>
      </div>

      <div class="hero__aside" data-reveal style="--reveal-delay: 180ms">
        <p class="code">{h.hero.quickTitle}</p>
        <ul class="hero__outcomes">
          {h.hero.outcomes.map((outcome) => (
            <li>
              <h2>{outcome.label}</h2>
              <p>{outcome.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <figure class="map-frame" data-reveal style="--reveal-delay: 220ms">
      <div class="map-frame__top">
        <div>
          <p class="code">{h.hero.mapTitle} · SYNTH-01</p>
          <p>{h.hero.mapCaption}</p>
        </div>
        <div>
          <p class="code">{h.hero.mapLegendTitle}</p>
          <CoverageLegend locale={locale} />
        </div>
      </div>
      <MandateUniverse locale={locale} variant="hero" id="mu-hero" />
      <figcaption class="map-frame__caption">
        <p>{h.hero.mapCaption}</p>
        <p class="code">{h.hero.mapTitle} · SYNTH-01</p>
      </figcaption>
    </figure>
  </div>
</section>

<!-- 02 — the three buyer-visible bottlenecks -->
<section class="section" id="bottleneck">
  <div class="shell">
    <SectionHead
      eyebrow={h.bottleneck.eyebrow}
      title={h.bottleneck.title}
      lede={h.bottleneck.lede}
      sheet="02 / 06"
      sheetLabel={sheetLabel}
    />
    <ul class="card-grid">
      {h.bottleneck.items.slice(0, 3).map((item, index) => (
        <li class="card card--marked" data-reveal style={`--reveal-delay: ${index * 70}ms`}>
          <div class="card__head">
            <h3>{item.label}</h3>
            <span class="code">{String(index + 1).padStart(2, '0')}</span>
          </div>
          <p class="card__body">{item.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- 03 — the homepage explains three phases; the demo retains all seven steps -->
<section class="section panel--ink" id="product">
  <div class="shell">
    <SectionHead
      eyebrow={h.workflow.eyebrow}
      title={h.workflow.title}
      lede={h.workflow.lede}
      sheet="03 / 06"
      sheetLabel={sheetLabel}
    />
    <ol class="phase-grid" id="workflow">
      {workflowPhases.map((phase) => (
        <li class="phase-card" data-reveal>
          <span class="step__n" aria-hidden="true">{phase.n}</span>
          <h3>{phase.title}</h3>
          <p>{phase.body}</p>
          <p class="step__stamp"><span aria-hidden="true">✓</span>{phase.stamp}</p>
        </li>
      ))}
    </ol>
    <p class="field-note" data-reveal>{h.workflow.note}</p>
  </div>
</section>

<!-- 04 — short demo proof, not a second explanation of the same workflow -->
<section class="section" id="demo">
  <div class="shell">
    <SectionHead
      eyebrow={h.demo.eyebrow}
      title={h.demo.title}
      lede={h.demo.lede}
      sheet="04 / 06"
      sheetLabel={sheetLabel}
    />
    <div class="demo-teaser" data-reveal>
      <ul class="checklist">
        {h.demo.points.slice(0, 3).map((point) => (
          <li><span class="checklist__mark" aria-hidden="true">✓</span><span>{point}</span></li>
        ))}
      </ul>
      <div>
        <a class="btn btn--primary" href={route('demo', locale)}>
          {h.demo.cta}<span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        <p class="note-inline" style="margin-top: 1rem; max-width: 40ch">{h.demo.note}</p>
      </div>
    </div>
  </div>
</section>

<!-- 05 — system fit and human boundary in one place -->
<section class="section panel--sunk" id="stack">
  <div class="shell">
    <SectionHead
      eyebrow={h.stack.eyebrow}
      title={h.stack.title}
      lede={h.stack.lede}
      sheet="05 / 06"
      sheetLabel={sheetLabel}
    />
    <div class="stack-grid">
      {[
        [h.stack.inputTitle, h.stack.inputItems],
        [h.stack.coreTitle, h.stack.coreItems],
        [h.stack.outputTitle, h.stack.outputItems],
      ].map(([title, items]) => (
        <article class="stack-card" data-reveal>
          <h3>{title}</h3>
          <ul>{(items as readonly string[]).map((item) => <li>{item}</li>)}</ul>
        </article>
      ))}
    </div>
    <div class="boundary-grid" data-reveal>
      <div>
        <p class="eyebrow">{h.human.humanTitle}</p>
        <ul>{h.human.humanItems.slice(0, 3).map((item) => <li>{item}</li>)}</ul>
      </div>
      <div>
        <p class="eyebrow">{h.human.neverTitle}</p>
        <ul>{h.human.neverItems.slice(0, 3).map((item) => <li>{item}</li>)}</ul>
      </div>
      <div class="boundary-link">
        <p>{h.human.note}</p>
        <a class="link" href={route('method', locale)}>{dict.nav.method} →</a>
      </div>
    </div>
  </div>
</section>

<!-- 06 — one conversion section: fixed diagnostic, partnership, evidence -->
<section class="section panel--ink" id="design-partners">
  <div class="shell">
    <SectionHead
      eyebrow={h.partners.eyebrow}
      title={h.partners.title}
      lede={h.partners.lede}
      sheet="06 / 06"
      sheetLabel={sheetLabel}
    />

    <div class="offer-grid">
      <article class="offer-card offer-card--price" data-reveal>
        <p class="eyebrow">Mandate Intelligence Diagnostic</p>
        <p class="offer-price num">55 000 <span>SEK</span></p>
        <p>{locale === 'sv' ? 'Exklusive moms · ett uppdrag · en primär landsram' : 'Excluding VAT · one mandate · one primary country frame'}</p>
        <ul>
          {h.partners.deliverables.slice(0, 4).map((item) => <li>{item}</li>)}
        </ul>
      </article>
      <article class="offer-card" data-reveal>
        <p class="eyebrow">{h.partners.termsTitle}</p>
        <h3>{locale === 'sv' ? 'Betalt designpartnerskap' : 'Paid design partnership'}</h3>
        <ul>{h.partners.terms.slice(0, 4).map((item) => <li>{item}</li>)}</ul>
        <p class="note-inline">{h.partners.priceNote}</p>
      </article>
      <article class="offer-card" data-reveal>
        <p class="eyebrow">{h.partners.fitTitle}</p>
        <ul>{h.partners.fit.slice(0, 4).map((item) => <li>{item}</li>)}</ul>
        <p class="note-inline">{h.partners.applyStatus}</p>
      </article>
    </div>

    <div id="evidence" class="evidence-compact">
      <SectionHead
        eyebrow={h.evidence.eyebrow}
        title={h.evidence.title}
        lede={h.evidence.lede}
        sheet="E / 03"
        sheetLabel={sheetLabel}
      />
      <ClaimLedger locale={locale} claims={claims} caption={h.evidence.title} />
      <div class="btn-row">
        <a class="btn btn--secondary" href={route('method', locale)}>{h.evidence.cta}</a>
        <a class="btn btn--secondary" href={route('market', locale)}>{dict.nav.market}</a>
        <a class="btn btn--primary" href={anchor(locale, 'design-partners')}>
          {h.finalCta.primaryCta}<span class="btn__arrow" aria-hidden="true">↑</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .phase-grid,
  .offer-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    padding: 1px;
    background: var(--rule-on-ink);
    list-style: none;
  }

  .phase-card,
  .offer-card {
    padding: clamp(1.25rem, 3vw, 2rem);
    background: var(--ink);
  }

  .phase-card h3,
  .offer-card h3 {
    margin-top: 1.5rem;
  }

  .phase-card > p:not(.step__stamp),
  .offer-card > p,
  .offer-card li {
    color: var(--on-ink-muted);
  }

  .boundary-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1.2fr;
    gap: clamp(1rem, 3vw, 2.5rem);
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }

  .boundary-grid li {
    margin-block: 0.65rem;
  }

  .boundary-link {
    border-inline-start: 2px solid var(--cobalt);
    padding-inline-start: 1.25rem;
  }

  .offer-card--price {
    background: var(--cobalt);
  }

  .offer-card--price > p,
  .offer-card--price .eyebrow,
  .offer-card--price li,
  .offer-card--price .offer-price span {
    color: var(--on-ink);
  }

  .offer-price {
    margin: 1rem 0 0;
    color: var(--on-ink);
    font: 600 clamp(2.5rem, 6vw, 4.5rem) / 1 var(--font-display);
    letter-spacing: -0.05em;
  }

  .offer-price span {
    font: 700 var(--step--1) / 1 var(--font-sans);
    letter-spacing: 0.08em;
  }

  .evidence-compact {
    margin-top: clamp(4rem, 9vw, 8rem);
    scroll-margin-top: 6rem;
  }

  .evidence-compact .btn-row {
    margin-top: 2rem;
  }

  .evidence-compact :global(.ledger__passage) {
    color: var(--on-ink-muted);
  }

  .evidence-compact :global(.ledger__gloss) {
    color: var(--on-ink-muted);
  }

  .evidence-compact :global(.ledger__flag) {
    color: var(--mint-light);
  }

  @media (max-width: 56rem) {
    .phase-grid,
    .offer-grid,
    .boundary-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 28rem) {
    .hero h1 {
      overflow-wrap: anywhere;
    }
  }
</style>
