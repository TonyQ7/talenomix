---
import type { Locale } from '~/lib/routes';
import { route } from '~/lib/routes';
import { t } from '~/i18n';
import { CLAIMS } from '~/data/claims';
import { COVERAGE_MATRIX, MARKET_FIGURES } from '~/data/market';
import { barRow, dotPlot } from '~/lib/chart';
import SectionHead from '~/components/SectionHead.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const m = dict.market;
const sourceById = new Map(CLAIMS.map((claim) => [claim.id, claim.source]));
// Every figure in the contract is rendered, grouped by market. Hand-picking a
// subset here is how the page silently stops reflecting the data — and
// tests/data.spec.ts asserts the full count for exactly that reason.
const figuresByCountry = MARKET_FIGURES.reduce<Map<string, typeof MARKET_FIGURES>>(
  (acc, figure) => {
    const existing = acc.get(figure.country) ?? [];
    acc.set(figure.country, [...existing, figure]);
    return acc;
  },
  new Map(),
);
const marketOrder = [...figuresByCountry.keys()].sort();

// The three charts below illustrate the Finnish directory series specifically,
// so they are looked up by id rather than taken from whatever happens to be first.
const byId = new Map(MARKET_FIGURES.map((figure) => [figure.id, figure]));
const fiFirms = byId.get('fi-firms-2023')!;
const fiExclusive = byId.get('fi-exclusive-2023')!;
const fiYoy = byId.get('fi-yoy-2023')!;

function valueLabel(value: number | null, unit: string): string {
  if (value === null) return m.notPublished;
  if (unit === 'EUR millions') return `€${value}m`;
  if (unit === 'percent') return `${value}%`;
  return new Intl.NumberFormat(locale === 'sv' ? 'sv-SE' : 'en-GB').format(value);
}
---

<section class="market-hero">
  <div class="shell">
    <p class="eyebrow">{m.eyebrow}</p>
    <h1>{m.title}</h1>
    <p class="lede">{m.lede}</p>
  </div>
</section>

<section class="section panel--sunk">
  <div class="shell">
    <div class="market-caveat">
      <p class="eyebrow">{m.caveatTitle}</p>
      <p>{m.caveatBody}</p>
    </div>
    <SectionHead
      eyebrow={m.eyebrow}
      title={m.metricsTitle}
      lede={m.caveatBody}
      sheet="01 / 02"
      sheetLabel={dict.ui.sheet}
    />

    {
      marketOrder.map((country) => (
        <div class="market-group">
          <p class="code market-group__head">
            {dict.countries[country as keyof typeof dict.countries] ?? country}
          </p>
          <div class="market-metrics">
            {(figuresByCountry.get(country) ?? []).map((figure) => (
              <article class="market-metric">
                <p class="num market-metric__value">{valueLabel(figure.value, figure.unit)}</p>
                <h2>{figure.label[locale]}</h2>
                <p>{figure.caveat[locale]}</p>
                <p class="code">{figure.period} · {figure.basis} · {figure.confidence}</p>
              </article>
            ))}
          </div>
        </div>
      ))
    }

    <div class="market-charts" aria-label={m.metricsTitle}>
      <div set:html={barRow(fiFirms.label[locale], fiFirms.value ?? 0, fiFirms.value ?? 1)} />
      <div set:html={barRow(fiExclusive.label[locale], fiExclusive.value ?? 0, fiFirms.value ?? 1)} />
      <div set:html={dotPlot(fiYoy.label[locale], fiYoy.value ?? 0, -10, 10, '%')} />
    </div>
  </div>
</section>

<section class="section">
  <div class="shell">
    <SectionHead
      eyebrow={m.eyebrow}
      title={m.coverageTitle}
      lede={m.coverageLede}
      sheet="02 / 02"
      sheetLabel={dict.ui.sheet}
    />
    <div class="table-scroll" tabindex="0" role="region" aria-label={m.coverageTitle}>
      <table class="coverage-table">
        <thead>
          <tr>
            <th>{m.tableHeads.country}</th>
            <th>{m.tableHeads.frame}</th>
            <th>{m.tableHeads.publishedCount}</th>
            <th>{m.tableHeads.status}</th>
            <th>{m.tableHeads.source}</th>
          </tr>
        </thead>
        <tbody>
          {COVERAGE_MATRIX.map((row) => {
            const source = sourceById.get(row.sourceId);
            return (
              <tr>
                <th scope="row">{row.country}</th>
                <td>{row.frame[locale]}</td>
                <td class="num">{row.publishedCount ?? m.notPublished}</td>
                <td>{row.status[locale]}</td>
                <td>
                  {source && (
                    <a href={source.url} target="_blank" rel="noopener nofollow">
                      {source.publisher}<span class="visually-hidden"> ({dict.ui.opensNewTab})</span>
                    </a>
                  )}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>

    <div class="market-source-note">
      <p>{m.sourceNote}</p>
      <a class="btn btn--secondary" href={route('method', locale)}>{m.methodCta}</a>
    </div>
  </div>
</section>

<style>
  .market-hero {
    padding: clamp(5rem, 11vw, 10rem) 0 clamp(3rem, 8vw, 7rem);
    border-bottom: 1px solid var(--rule);
  }

  .market-hero h1 {
    max-width: 14ch;
    margin: 0.5rem 0 1.5rem;
  }

  .market-caveat {
    max-width: 65ch;
    padding: 1.25rem;
    margin-bottom: clamp(3rem, 7vw, 6rem);
    border-inline-start: 3px solid var(--cobalt);
    background: var(--paper-raised);
  }

  .market-caveat p:last-child {
    margin-bottom: 0;
  }

  .market-group + .market-group {
    margin-top: clamp(1.75rem, 4vw, 3rem);
  }

  .market-group__head {
    padding-bottom: 0.6rem;
    margin-bottom: 0.9rem;
    border-bottom: 1px solid var(--rule);
  }

  /* auto-fit, not a fixed track count: a market with three figures would
     otherwise leave empty cells showing the grid's own rule colour. */
  .market-metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
  }

  .market-metric {
    padding: clamp(1rem, 3vw, 1.8rem);
    background: var(--paper);
  }

  .market-metric h2 {
    font: 700 var(--step--1) / 1.2 var(--font-sans);
  }

  .market-metric__value {
    margin: 0 0 1.5rem;
    font: 400 clamp(2.4rem, 5vw, 4.5rem) / 1 var(--font-display);
    letter-spacing: -0.035em;
    letter-spacing: -0.05em;
  }

  .market-charts {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
  }

  .market-charts :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    font-family: var(--font-sans);
    font-size: 15px;
  }

  .market-charts :global(.market-bar__track) {
    fill: var(--rule);
  }

  .market-charts :global(.market-bar__value) {
    fill: var(--cobalt);
  }

  .market-charts :global(.market-bar__number) {
    font-variant-numeric: tabular-nums;
    font-weight: 700;
  }

  .market-charts :global(.market-dot line) {
    stroke: var(--rule-strong);
    stroke-width: 2;
  }

  .market-charts :global(.market-dot circle) {
    fill: var(--mint-deep);
    stroke: var(--ink);
    stroke-width: 2;
  }

  .coverage-table th:first-child {
    font-variant-numeric: tabular-nums;
    font-size: var(--step-0);
  }

  .market-source-note {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    margin-top: 2rem;
  }

  .market-source-note p {
    max-width: 65ch;
  }

  @media (max-width: 56rem) {
    .market-source-note {
      align-items: flex-start;
      flex-direction: column;
    }
  }

</style>
